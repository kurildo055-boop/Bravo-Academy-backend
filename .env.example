# ==============================================================================
# BRAVO ACADEMY — PRODUCTION ENVIRONMENT VARIABLES (VERCEL / SUPABASE)
# ==============================================================================
# Copy these key-value pairs into your Vercel Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL Connection)
# ------------------------------------------------------------------------------
# NOTE: If your Supabase password contains special characters like '#' or '+',
# they MUST be percent-encoded ('#' -> '%23', '+' -> '%2B') in the connection string.
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (JWT Secrets)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="bravo_jwt_access_military_guard_2026_super_secure_key_x99"
JWT_REFRESH_SECRET="bravo_jwt_refresh_military_guard_2026_super_secure_key_x99"

# ------------------------------------------------------------------------------
# 3. APPLICATION DOMAINS
# ------------------------------------------------------------------------------
# Set this to your live Vercel URL (e.g. https://bravo-academy.vercel.app) or custom domain
FRONTEND_URL="https://your-domain.vercel.app"
BACKEND_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_API_URL="https://your-domain.vercel.app/api"
NEXT_PUBLIC_APP_NAME="Bravo Academy"

# ------------------------------------------------------------------------------
# 4. ADMIN SEED CREDENTIALS (Default Command Center)
# ------------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL="admin@bravoacademy.com"
ADMIN_INITIAL_PASSWORD="Admin@Bravo2026!"
WHATSAPP_CONTACT="+8801711223344"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS (bKash & Nagad - Sandbox / Merchant Credentials)
# ------------------------------------------------------------------------------
BKASH_APP_KEY="sandbox_bkash_app_key"
BKASH_APP_SECRET="sandbox_bkash_app_secret"
BKASH_USERNAME="sandbox_bkash_user"
BKASH_PASSWORD="sandbox_bkash_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

NAGAD_MERCHANT_ID="NAGAD_BRAVO_TEST"
NAGAD_MERCHANT_NUMBER="01711000000"
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""
NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"

# ------------------------------------------------------------------------------
# 6. AI SERVICE / EVALUATION (Optional)
# ------------------------------------------------------------------------------
AI_API_KEY=""
AI_MODEL="gemini-1.5-pro"
